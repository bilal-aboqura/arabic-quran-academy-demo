{
  "name": "my-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:seed:arabic-demo": "tsx scripts/seed-arabic-academy.ts",
    "db:backfill:legacy-tenant": "tsx scripts/backfill-legacy-tenant.ts",
    "db:finalize:tenant-constraints": "tsx scripts/finalize-tenant-constraints.ts",
    "test:finance:integration": "tsx scripts/verify-finance-concurrency.ts",
    "test:migration:rehearsal": "tsx scripts/verify-legacy-migration-rehearsal.ts",
    "test:tenant-uniqueness:integration": "tsx scripts/verify-tenant-local-uniqueness.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.990.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "lucide-react": "^1.40.0",
    "next": "16.1.6",
    "next-auth": "^4.24.13",
    "nextjs-toploader": "^3.9.17",
    "plyr": "^3.8.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "three": "^0.183.2",
    "zod": "^4.3.6"
  },
  "overrides": {
    "next-auth": {
      "next": "16.1.6"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.183.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.7",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }

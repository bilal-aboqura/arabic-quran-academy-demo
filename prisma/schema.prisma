  timeLimitMinutes Int?      @map("time_limit_minutes")
  /// Quiz settings are intentionally distinct from the legacy course-wide
  /// attempt limit. A null maxAttempts inherits that legacy course setting.
  maxAttempts      Int?      @map("max_attempts")
  /// Percentage required to pass (0 through 100). Null means no pass gate.
  passingScore     Int?      @map("passing_score")
  /// Defaults to true so existing quizzes remain reachable after the

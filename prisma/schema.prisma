// Prisma schema — PostgreSQL (VPS / local). Source of truth for `prisma db push`.
// Set DATABASE_URL in .env, then: npx prisma generate && npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum TenantRole {
  OWNER
  ADMIN
  TEACHER
  ASSISTANT
  STUDENT
}

enum TenantMembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}

enum TenantDomainKind {
  SUBDOMAIN
  CUSTOM
}

enum TenantDomainStatus {
  PENDING
  ACTIVE
  DISABLED
}

/// Immutable reason for a change to a student's tenant-local wallet. Amounts
/// are signed: credits are positive and purchases are negative.
enum TenantBalanceTransactionKind {
  LEGACY_OPENING_BALANCE
  MANUAL_CREDIT
  COURSE_PURCHASE
  STORE_PURCHASE
  SUBSCRIPTION_PURCHASE
}

/// External providers are selected server-side. This is intentionally distinct
/// from a tenant's internal student wallet balance.
enum PaymentProvider {
  LOCAL_TEST
  PAYMOB
  KASHIER
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum OrderItemKind {
  COURSE
  STORE_PRODUCT
  SUBSCRIPTION_PLAN
}

enum AssignmentSubmissionStatus {
  NOT_SUBMITTED
  SUBMITTED
  LATE
  REVIEWED
}

enum PageSectionType {
  HERO
  COURSES
  CATEGORIES
  ABOUT
  STATS
  TEACHERS
  TESTIMONIALS
  FAQ
  CONTACT
  CTA
  FEATURES
  RESULTS
  VIDEO
  SOCIAL_PROOF
}

enum SiteStatus {
  DRAFT
  PUBLISHED
}

/// These statuses describe the academy's NexaClass subscription. They are
/// deliberately separate from student-facing SubscriptionPlan records.
enum TenantSubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

model User {
  id                   String   @id @default(cuid())
  email                String   @unique
  password             String   @map("password_hash")
  name                 String
  role                 String   @default("STUDENT")
  balance              Decimal  @default(0) @db.Decimal(10, 2)
  studentNumber        String?  @map("student_number")
  guardianNumber       String?  @map("guardian_number")
  copyrightCode        String?  @map("copyright_code") @db.VarChar(10)
  teacherSubject       String?  @map("teacher_subject")
  teacherAvatarUrl     String?  @map("teacher_avatar_url")
  teacherHomepageOrder Int?     @map("teacher_homepage_order")
  currentSessionId     String?  @map("current_session_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  enrollments            Enrollment[]
  coursesCreated         Course[]                   @relation("CourseCreator")
  categoriesCreated      Category[]                 @relation("CategoryCreator")
  quizAttempts           QuizAttempt[]
  activationCodesUsed    ActivationCode[]           @relation("ActivationCodeUser")
  payments               Payment[]
  orders                 Order[]
  paymentAttempts        PaymentAttempt[]
  homeworkSubmissions    HomeworkSubmission[]
  conversationsAsStaff   Conversation[]             @relation("ConversationStaff")
  conversationsAsStudent Conversation[]             @relation("ConversationStudent")
  messagesSent           Message[]
  storePurchases         UserStorePurchase[]
  platformSubscriptions  UserPlatformSubscription[]
  lessonRatings          LessonRating[]
  lessonPlaybackAttempts LessonPlaybackAttempt[]
  tenantMemberships      TenantMembership[]
  passwordResetTokens    PasswordResetToken[]
  auditLogs              AuditLog[]                 @relation("AuditLogActorUser")
  platformAdministrator  PlatformAdministrator?

  @@index([copyrightCode])
  @@map("User")
}

/// A tenant is an independently branded school, academy, or teacher platform.
/// User identities remain global; access is granted only through memberships.
model Tenant {
  id        String       @id @default(cuid())
  slug      String       @unique
  name      String
  nameAr    String?      @map("name_ar")
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  memberships            TenantMembership[]
  domains                TenantDomain[]
  settings               TenantSettings?
  auditLogs              AuditLog[]
  categories             Category[]
  courses                Course[]
  enrollments            Enrollment[]
  activationCodes        ActivationCode[]
  payments               Payment[]
  orders                 Order[]
  paymentAttempts        PaymentAttempt[]
  liveStreams            LiveStream[]
  homeworkSubmissions    HomeworkSubmission[]
  conversations          Conversation[]
  messages               Message[]
  storeProducts          StoreProduct[]
  storePurchases         UserStorePurchase[]
  subscriptionPlans      SubscriptionPlan[]
  platformSubscriptions  UserPlatformSubscription[]
  lessonRatings          LessonRating[]
  lessonPlaybackAttempts LessonPlaybackAttempt[]
  quizAttempts           QuizAttempt[]
  reviews                Review[]
  studentAccounts        TenantStudentAccount[]
  balanceTransactions    TenantBalanceTransaction[]
  lessonProgress         LessonProgress[]
  courseProgress         CourseProgress[]
  assignments            Assignment[]
  assignmentSubmissions  AssignmentSubmission[]
  site                   Site?
  saasSubscription       TenantSubscription?
  saasInvoices           SaaSInvoice[]
  notifications          Notification[]

  @@index([status])
  @@map("Tenant")
}

enum PlatformAdminRole {
  SUPER_ADMIN
  PLATFORM_ADMIN
  SUPPORT_ADMIN
}

/// Platform authority is an explicit grant, never an interpretation of a
/// tenant membership or the legacy User.role field.
model PlatformAdministrator {
  id        String            @id @default(cuid())
  userId    String            @unique @map("user_id")
  role      PlatformAdminRole @default(PLATFORM_ADMIN)
  isActive  Boolean           @default(true) @map("is_active")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@map("PlatformAdministrator")
}

/// Configurable commercial offer for a NexaClass tenant. Prices are data, not
/// hard-coded into application logic. JSON columns intentionally support a
/// controlled, forward-compatible feature/limit catalogue.
model SaaSPlan {
  id                    String   @id @default(cuid())
  code                  String   @unique
  name                  String
  description           String   @default("") @db.Text
  currency              String   @default("EGP") @db.VarChar(3)
  price                 Decimal  @default(0) @db.Decimal(12, 2)
  billingIntervalMonths Int      @default(1) @map("billing_interval_months")
  trialMonths           Int      @default(0) @map("trial_months")
  featureFlags          Json     @default("{}") @map("feature_flags")
  limits                Json     @default("{}")
  isActive              Boolean  @default(true) @map("is_active")
  sortOrder             Int      @default(0) @map("sort_order")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  tenantSubscriptions TenantSubscription[]
  invoices            SaaSInvoice[]

  @@index([isActive, sortOrder])
  @@map("SaaSPlan")
}

/// Exactly one current platform subscription is attached to an academy. It
/// cannot be confused with UserPlatformSubscription, which sells products to
/// students inside one tenant.
model TenantSubscription {
  id                   String                   @id @default(cuid())
  tenantId             String                   @unique @map("tenant_id")
  planId               String                   @map("plan_id")
  status               TenantSubscriptionStatus @default(TRIAL)
  currentPeriodStart   DateTime                 @default(now()) @map("current_period_start")
  currentPeriodEnd     DateTime?                @map("current_period_end")
  trialEndsAt          DateTime?                @map("trial_ends_at")
  canceledAt           DateTime?                @map("canceled_at")
  featureFlagOverrides Json                     @default("{}") @map("feature_flag_overrides")
  limitOverrides       Json                     @default("{}") @map("limit_overrides")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   SaaSPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId, status])
  @@index([status, currentPeriodEnd])
  @@map("TenantSubscription")
}

model SaaSInvoice {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  planId        String?  @map("plan_id")
  amount        Decimal  @db.Decimal(12, 2)
  currency      String   @default("EGP") @db.VarChar(3)
  status        String   @default("PAID")
  periodStart   DateTime @map("period_start")
  periodEnd     DateTime @map("period_end")
  provider      String   @default("MANUAL")
  transactionId String?  @map("transaction_id")
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   SaaSPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("SaaSInvoice")
}

/// Tenant-scoped identity, role, and profile data. This is the future source
/// of authorization; User.role is retained only for the legacy bridge.
model TenantMembership {
  id                   String                 @id @default(cuid())
  tenantId             String                 @map("tenant_id")
  userId               String                 @map("user_id")
  role                 TenantRole
  status               TenantMembershipStatus @default(ACTIVE)
  displayName          String?                @map("display_name")
  studentNumber        String?                @map("student_number")
  guardianNumber       String?                @map("guardian_number")
  teacherSubject       String?                @map("teacher_subject")
  teacherBio           String?                @map("teacher_bio")
  teacherLanguages     String?                @map("teacher_languages")
  teacherAvatarUrl     String?                @map("teacher_avatar_url")
  teacherHomepageOrder Int?                   @map("teacher_homepage_order")
  copyrightCode        String?                @map("copyright_code") @db.VarChar(10)
  joinedAt             DateTime               @default(now()) @map("joined_at")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  tenant                Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                  User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs             AuditLog[]                 @relation("AuditLogActorMembership")
  studentEnrollments    Enrollment[]               @relation("EnrollmentStudentMembership")
  studentAccount        TenantStudentAccount?
  balanceTransactions   TenantBalanceTransaction[]
  paymentOrders         Order[]
  quizAttempts          QuizAttempt[]              @relation("QuizAttemptStudentMembership")
  lessonProgress        LessonProgress[]           @relation("LessonProgressStudentMembership")
  courseProgress        CourseProgress[]           @relation("CourseProgressStudentMembership")
  assignmentsAuthored   Assignment[]               @relation("AssignmentAuthorMembership")
  assignmentSubmissions AssignmentSubmission[]     @relation("AssignmentStudentMembership")
  assignmentReviews     AssignmentSubmission[]     @relation("AssignmentReviewerMembership")
  notifications         Notification[]

  @@unique([tenantId, userId])
  @@index([userId, status])
  @@index([tenantId, role, status])
  @@map("TenantMembership")
}

/// A wallet belongs to a *student membership*, never to a global identity.
/// The unique tenant/membership pair also makes an accidental cross-tenant
/// debit structurally impossible through the commerce service.
model TenantStudentAccount {
  id                  String   @id @default(cuid())
  tenantId            String   @map("tenant_id")
  studentMembershipId String   @unique @map("student_membership_id")
  balance             Decimal  @default(0) @db.Decimal(12, 2)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant            Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentMembership TenantMembership           @relation(fields: [studentMembershipId], references: [id], onDelete: Cascade)
  transactions      TenantBalanceTransaction[]

  @@unique([tenantId, studentMembershipId])
  @@index([tenantId])
  @@map("TenantStudentAccount")
}

/// Append-only financial journal for the legacy stored-balance commerce
/// bridge. This is deliberately separate from future external gateway orders.
model TenantBalanceTransaction {
  id                  String                       @id @default(cuid())
  tenantId            String                       @map("tenant_id")
  studentMembershipId String                       @map("student_membership_id")
  accountId           String                       @map("account_id")
  kind                TenantBalanceTransactionKind
  amount              Decimal                      @db.Decimal(12, 2)
  idempotencyKey      String?                      @map("idempotency_key")
  referenceType       String?                      @map("reference_type")
  referenceId         String?                      @map("reference_id")
  createdAt           DateTime                     @default(now()) @map("created_at")

  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentMembership TenantMembership     @relation(fields: [studentMembershipId], references: [id], onDelete: Cascade)
  account           TenantStudentAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, studentMembershipId, createdAt(sort: Desc)])
  @@index([accountId, createdAt(sort: Desc)])
  @@map("TenantBalanceTransaction")
}

/// Host names are normalized to lowercase before persistence and resolution.
/// Only ACTIVE domains may resolve a tenant in production.
model TenantDomain {
  id         String             @id @default(cuid())
  tenantId   String             @map("tenant_id")
  hostname   String             @unique
  kind       TenantDomainKind
  status     TenantDomainStatus @default(PENDING)
  isPrimary  Boolean            @default(false) @map("is_primary")
  verifiedAt DateTime?          @map("verified_at")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("TenantDomain")
}

/// Operational tenant defaults and controlled visual identity.
model TenantSettings {
  id              String   @id @default(cuid())
  tenantId        String   @unique @map("tenant_id")
  platformName    String?  @map("platform_name")
  platformNameEn  String?  @map("platform_name_en")
  logoStorageKey  String?  @map("logo_storage_key")
  logoUrl         String?  @map("logo_url")
  faviconUrl      String?  @map("favicon_url")
  heroImageUrl    String?  @map("hero_image_url")
  primaryColor    String?  @map("primary_color")
  secondaryColor  String?  @map("secondary_color")
  accentColor     String?  @map("accent_color")
  fontPreference  String?  @map("font_preference")
  shortAbout      String?  @map("short_about") @db.Text
  seoTitle        String?  @map("seo_title")
  seoDescription  String?  @map("seo_description") @db.Text
  contactDetails  Json?    @map("contact_details")
  teachersEnabled Boolean  @default(false) @map("teachers_enabled")
  defaultLocale   String   @default("ar") @map("default_locale")
  timezone        String   @default("Africa/Cairo")
  currency        String   @default("EGP")
  socialLinks     Json?    @map("social_links")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("TenantSettings")
}

/// Controlled, section-based tenant website. This deliberately does not
/// expose arbitrary HTML, scripts, or cross-tenant references.
model Site {
  id              String     @id @default(cuid())
  tenantId        String     @unique @map("tenant_id")
  templateId      String?    @map("template_id")
  templateVersion Int?       @map("template_version")
  status          SiteStatus @default(DRAFT)
  publishedAt     DateTime?  @map("published_at")
  themeOverrides  Json       @default("{}") @map("theme_overrides")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template WebsiteTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  pages    SitePage[]

  @@map("Site")
}

/// Shared, versioned presentation definitions. Tenant-owned content remains in
/// Site/PageSection and is never embedded in a template record.
model WebsiteTemplate {
  id                String   @id @default(cuid())
  code              String   @unique
  name              String
  nameAr            String   @map("name_ar")
  description       String   @db.Text
  category          String
  thumbnail         String?
  previewImage      String?  @map("preview_image")
  isActive          Boolean  @default(true) @map("is_active")
  version           Int      @default(1)
  defaultTheme      Json     @default("{}") @map("default_theme")
  defaultPages      Json     @default("[]") @map("default_pages")
  defaultSections   Json     @default("[]") @map("default_sections")
  supportedFeatures Json     @default("[]") @map("supported_features")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  sites Site[]

  @@index([isActive, category])
  @@map("WebsiteTemplate")
}

model SitePage {
  id          String   @id @default(cuid())
  siteId      String   @map("site_id")
  slug        String
  title       String
  isHome      Boolean  @default(false) @map("is_home")
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  site     Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  sections PageSection[]

  @@unique([siteId, slug])
  @@index([siteId, isPublished])
  @@map("SitePage")
}

model PageSection {
  id        String          @id @default(cuid())
  pageId    String          @map("page_id")
  type      PageSectionType
  variant   String          @default("default")
  sortOrder Int             @default(0) @map("sort_order")
  enabled   Boolean         @default(true)
  config    Json            @default("{}")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  page SitePage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, sortOrder])
  @@map("PageSection")
}

/// Stores a one-way hash only; raw reset credentials are never persisted.
model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  requestedIp String?   @map("requested_ip")
  userAgent   String?   @map("user_agent")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("PasswordResetToken")
}

/// Immutable security and administration event trail. Do not store secrets,
/// raw reset tokens, passwords, or full private content in metadata.
model AuditLog {
  id                String   @id @default(cuid())
  tenantId          String?  @map("tenant_id")
  actorUserId       String?  @map("actor_user_id")
  actorMembershipId String?  @map("actor_membership_id")
  action            String
  targetType        String?  @map("target_type")
  targetId          String?  @map("target_id")
  metadata          Json?
  ipAddress         String?  @map("ip_address")
  userAgent         String?  @map("user_agent")
  createdAt         DateTime @default(now()) @map("created_at")

  tenant          Tenant?           @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actorUser       User?             @relation("AuditLogActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorMembership TenantMembership? @relation("AuditLogActorMembership", fields: [actorMembershipId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("AuditLog")
}

model Category {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  nameAr      String?  @map("name_ar")
  slug        String
  description String?
  imageUrl    String?  @map("image_url")
  order       Int      @default(0)
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  courses   Course[]
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("CategoryCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([tenantId, slug], map: "Category_tenant_slug_key")
  @@index([tenantId, order])
  @@map("Category")
}

model Course {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  title           String
  titleAr         String?  @map("title_ar")
  slug            String
  description     String   @db.Text
  descriptionEn   String?  @map("description_en") @db.Text
  shortDesc       String?  @map("short_desc") @db.VarChar(300)
  shortDescEn     String?  @map("short_desc_en") @db.VarChar(300)
  imageUrl        String?  @map("image_url")
  price           Decimal  @default(0) @db.Decimal(10, 2)
  duration        String?
  level           String?
  isPublished     Boolean  @default(false) @map("is_published")
  order           Int      @default(0)
  maxQuizAttempts Int?     @map("max_quiz_attempts")
  categoryId      String?  @map("category_id")
  createdById     String?  @map("created_by_id")
  acceptsHomework Boolean  @default(false) @map("accepts_homework")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  category            Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy           User?                @relation("CourseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lessons             Lesson[]
  quizzes             Quiz[]
  modules             CourseModule[]
  enrollments         Enrollment[]
  activationCodes     ActivationCode[]
  payments            Payment[]
  liveStreams         LiveStream[]
  homeworkSubmissions HomeworkSubmission[]
  lessonRatings       LessonRating[]
  lessonProgress      LessonProgress[]
  courseProgress      CourseProgress[]
  assignments         Assignment[]

  @@unique([tenantId, slug], map: "Course_tenant_slug_key")
  @@index([tenantId, isPublished])
  @@index([categoryId])
  @@index([createdById])
  @@map("Course")
}

/// An ordered, tenant-inherited grouping of course content.  The ID is never
/// recreated during editing: moving a lesson or quiz only changes its module
/// reference and order.  Existing courses remain valid with ungrouped content
/// until their first section is created.
model CourseModule {
  id          String   @id @default(cuid())
  courseId    String   @map("course_id")
  title       String
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  quizzes     Quiz[]
  assignments Assignment[]

  @@index([courseId, sortOrder])
  @@map("CourseModule")
}

/// A tenant-owned course task. Sections are optional so existing courses can
/// adopt assignments without destructive content-tree rewrites.
model Assignment {
  id                    String    @id @default(cuid())
  tenantId              String    @map("tenant_id")
  courseId              String    @map("course_id")
  moduleId              String?   @map("module_id")
  createdByMembershipId String    @map("created_by_membership_id")
  title                 String
  description           String    @default("") @db.Text
  deadline              DateTime?
  maxGrade              Int       @default(100) @map("max_grade")
  isPublished           Boolean   @default(false) @map("is_published")
  order                 Int       @default(0)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course              Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module              CourseModule?          @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  createdByMembership TenantMembership       @relation("AssignmentAuthorMembership", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  submissions         AssignmentSubmission[]

  @@index([tenantId, courseId, isPublished, order])
  @@index([moduleId, order])
  @@map("Assignment")
}

/// The only assignment attempt for a student membership. Absence of this row
/// is the explicit NOT_SUBMITTED state; submitted rows retain an immutable
/// submitted timestamp and a reviewer-owned grade/feedback record.
model AssignmentSubmission {
  id                     String                     @id @default(cuid())
  tenantId               String                     @map("tenant_id")
  assignmentId           String                     @map("assignment_id")
  studentMembershipId    String                     @map("student_membership_id")
  textContent            String?                    @map("text_content") @db.Text
  files                  Json?
  submittedAt            DateTime                   @default(now()) @map("submitted_at")
  status                 AssignmentSubmissionStatus @default(SUBMITTED)
  grade                  Decimal?                   @db.Decimal(7, 2)
  feedback               String?                    @db.Text
  reviewedByMembershipId String?                    @map("reviewed_by_membership_id")
  reviewedAt             DateTime?                  @map("reviewed_at")
  createdAt              DateTime                   @default(now()) @map("created_at")
  updatedAt              DateTime                   @updatedAt @map("updated_at")

  tenant               Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignment           Assignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentMembership    TenantMembership  @relation("AssignmentStudentMembership", fields: [studentMembershipId], references: [id], onDelete: Cascade)
  reviewedByMembership TenantMembership? @relation("AssignmentReviewerMembership", fields: [reviewedByMembershipId], references: [id], onDelete: SetNull)

  @@unique([tenantId, assignmentId, studentMembershipId])
  @@index([tenantId, studentMembershipId, status, submittedAt(sort: Desc)])
  @@index([assignmentId, status, submittedAt(sort: Desc)])
  @@map("AssignmentSubmission")
}

model Lesson {

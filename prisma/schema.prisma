  module                CourseModule?        @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  questions             Question[]
  quizAttempts          QuizAttempt[]
  activationCodeQuizzes ActivationCodeQuiz[]

  @@index([courseId])
  @@index([moduleId, order])
  @@index([isPublished, availableFrom, availableUntil])
  @@map("Quiz")
}


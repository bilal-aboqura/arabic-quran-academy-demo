  playbackLimitEnabled    Boolean  @default(true) @map("playback_limit_enabled")
  playbackRequiredMinutes Int      @default(15) @map("playback_required_minutes")
  playbackMaxAttempts     Int      @default(3) @map("playback_max_attempts")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  course                 Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module                 CourseModule?           @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  activationCodeLessons  ActivationCodeLesson[]

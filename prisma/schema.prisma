/// Server-authoritative per-lesson resume and completion state. Browser
/// storage may cache this state, but never replaces this membership-owned row.
model LessonProgress {
  id                  String    @id @default(cuid())
  tenantId            String    @map("tenant_id")
  studentMembershipId String    @map("student_membership_id")
  courseId            String    @map("course_id")
  lessonId            String    @map("lesson_id")
  positionSeconds     Int       @default(0) @map("position_seconds")
  completed           Boolean   @default(false)
  lastViewedAt        DateTime  @default(now()) @map("last_viewed_at")
  completedAt         DateTime? @map("completed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentMembership TenantMembership @relation("LessonProgressStudentMembership", fields: [studentMembershipId], references: [id], onDelete: Cascade)
  course            Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson            Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([tenantId, studentMembershipId, lessonId])
  @@index([tenantId, studentMembershipId, courseId, lastViewedAt(sort: Desc)])
  @@index([courseId, completed])
  @@map("LessonProgress")
}

/// Cached course roll-up, recomputed atomically whenever lesson progress is
/// recorded. Individual LessonProgress rows remain the source of truth.
model CourseProgress {
  id                  String    @id @default(cuid())
  tenantId            String    @map("tenant_id")
  studentMembershipId String    @map("student_membership_id")
  courseId            String    @map("course_id")
  completedLessons    Int       @default(0) @map("completed_lessons")
  totalLessons        Int       @default(0) @map("total_lessons")
  progressPercent     Int       @default(0) @map("progress_percent")
  completed           Boolean   @default(false)
  lastViewedAt        DateTime  @default(now()) @map("last_viewed_at")
  completedAt         DateTime? @map("completed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentMembership TenantMembership @relation("CourseProgressStudentMembership", fields: [studentMembershipId], references: [id], onDelete: Cascade)
  course            Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([tenantId, studentMembershipId, courseId])
  @@index([tenantId, studentMembershipId, lastViewedAt(sort: Desc)])
  @@index([courseId, completed])
  @@map("CourseProgress")
}

model Quiz {
  id               String    @id @default(cuid())

  addBalanceWaitingNote           String?  @map("add_balance_waiting_note")
  addBalanceWaitingNoteEn         String?  @map("add_balance_waiting_note_en")
  copyrightOverlayStyle           String?  @map("copyright_overlay_style")
  updatedAt                       DateTime @updatedAt @map("updated_at")

  @@map("HomepageSetting")
}

model HomeworkSubmission {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  courseId       String   @map("course_id")
  userId         String   @map("user_id")
  lessonId       String?  @map("lesson_id")
  submissionType String   @map("submission_type")
  linkUrl        String?  @map("link_url")
  fileUrl        String?  @map("file_url")
  fileName       String?  @map("file_name")
  createdAt      DateTime @default(now()) @map("created_at")

  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([tenantId, userId])
  @@index([userId])
  @@index([createdAt])
  @@index([lessonId])
  @@map("HomeworkSubmission")
}

model Conversation {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  staffUserId   String   @map("staff_user_id")
  studentUserId String   @map("student_user_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  staffUser   User      @relation("ConversationStaff", fields: [staffUserId], references: [id], onDelete: Cascade)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentUser User      @relation("ConversationStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@unique([tenantId, staffUserId, studentUserId], map: "Conversation_tenant_staff_student_key")
  @@index([tenantId, staffUserId])
  @@index([tenantId, studentUserId])
  @@index([staffUserId])
  @@index([studentUserId])
  @@map("Conversation")
}

model Message {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  messageType    String   @map("message_type")
  content        String?  @db.Text
  fileUrl        String?  @map("file_url")
  fileName       String?  @map("file_name")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([tenantId, conversationId])
  @@index([createdAt])
  @@map("Message")
}

model StoreProduct {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  title       String
  description String   @default("") @db.Text
  price       Decimal  @default(0) @db.Decimal(10, 2)
  costPrice   Decimal  @default(0) @map("cost_price") @db.Decimal(10, 2)
  imageUrl    String?  @map("image_url")
  pdfUrl      String?  @map("pdf_url")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  purchases UserStorePurchase[]
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive, sortOrder, createdAt(sort: Desc)])
  @@index([isActive, sortOrder, createdAt(sort: Desc)])
  @@map("StoreProduct")
}

model UserStorePurchase {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  productId String   @map("product_id")
  pricePaid Decimal  @default(0) @map("price_paid") @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product StoreProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([tenantId, userId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("UserStorePurchase")
}

model SubscriptionPlan {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  name         String
  description  String   @default("") @db.Text
  imageUrl     String?  @map("image_url")
  durationKind String   @map("duration_kind")
  price        Decimal  @default(0) @db.Decimal(10, 2)
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  subscriptions UserPlatformSubscription[]
  tenant        Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive, sortOrder])
  @@index([isActive, sortOrder])
  @@map("SubscriptionPlan")
}

model UserPlatformSubscription {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  planId    String?  @map("plan_id")
  pricePaid Decimal  @default(0) @map("price_paid") @db.Decimal(10, 2)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@index([tenantId, userId, expiresAt])
  @@map("UserPlatformSubscription")
}

model LessonRating {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  lessonId  String   @map("lesson_id")
  userId    String   @map("user_id")
  courseId  String   @map("course_id")
  rating    Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId], map: "lesson_rating_unique_lesson_user")
  @@index([lessonId])
  @@index([tenantId, lessonId])
  @@index([courseId])
  @@index([userId])
  @@map("LessonRating")
}

model LessonPlaybackAttempt {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  userId          String    @map("user_id")
  lessonId        String    @map("lesson_id")
  watchedSeconds  Int       @default(0) @map("watched_seconds")
  isPlaying       Boolean   @default(false) @map("is_playing")
  startedAt       DateTime  @default(now()) @map("started_at")
  lastHeartbeatAt DateTime  @default(now()) @map("last_heartbeat_at")
  countedAt       DateTime? @map("counted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, lessonId])
  @@index([tenantId, userId, lessonId])
  @@index([userId, lessonId, countedAt])
  @@map("LessonPlaybackAttempt")
}

enum NotificationKind {
  ENROLLMENT
  PAYMENT
  ASSIGNMENT_SUBMITTED
  ASSIGNMENT_GRADED
  QUIZ_COMPLETED
  ANNOUNCEMENT
  SYSTEM
}

model Notification {
  id                    String           @id @default(cuid())
  tenantId              String           @map("tenant_id")
  recipientMembershipId String           @map("recipient_membership_id")
  kind                  NotificationKind
  title                 String
  titleAr               String?          @map("title_ar")
  message               String           @db.Text
  messageAr             String?          @map("message_ar") @db.Text
  linkUrl               String?          @map("link_url")
  isRead                Boolean          @default(false) @map("is_read")
  readAt                DateTime?        @map("read_at")
  createdAt             DateTime         @default(now()) @map("created_at")

  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipientMembership TenantMembership @relation(fields: [recipientMembershipId], references: [id], onDelete: Cascade)

  @@index([tenantId, recipientMembershipId, isRead, createdAt(sort: Desc)])
  @@map("Notification")
}

model Payment {
  id                String           @id @default(cuid())
  tenantId          String           @map("tenant_id")
  userId            String           @map("user_id")
  /// Legacy wallet course payments retain this relationship. External
  /// store/subscription payments intentionally have no course.
  courseId          String?          @map("course_id")
  orderId           String?          @unique @map("order_id")
  provider          PaymentProvider?
  providerReference String?          @map("provider_reference")
  status            PaymentStatus    @default(PAID)
  currency          String           @default("EGP") @db.VarChar(3)
  amount            Decimal          @db.Decimal(10, 2)
  settledAt         DateTime?        @map("settled_at")
  createdAt         DateTime         @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order  Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, provider, createdAt])
  @@map("Payment")
}

/// A server-created, immutable priced intent. Client code can request an
/// order, but it can never declare it paid or choose the amount.
model Order {
  id                  String           @id @default(cuid())
  tenantId            String           @map("tenant_id")
  userId              String           @map("user_id")
  studentMembershipId String           @map("student_membership_id")
  status              OrderStatus      @default(PENDING)
  provider            PaymentProvider?
  providerReference   String?          @map("provider_reference")
  currency            String           @default("EGP") @db.VarChar(3)
  amountMinor         Int              @map("amount_minor")
  idempotencyKey      String           @map("idempotency_key")
  description         String           @default("")
  paidAt              DateTime?        @map("paid_at")
  failedAt            DateTime?        @map("failed_at")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentMembership TenantMembership @relation(fields: [studentMembershipId], references: [id], onDelete: Cascade)
  items             OrderItem[]
  payment           Payment?
  attempts          PaymentAttempt[]

  @@unique([tenantId, userId, idempotencyKey])
  @@index([tenantId, userId, status, createdAt(sort: Desc)])
  @@index([studentMembershipId, createdAt(sort: Desc)])
  @@index([provider, providerReference])
  @@map("Order")
}

/// A product snapshot prevents later title/price edits from changing an
/// already-initiated order. Targets are checked against the tenant again when
/// the entitlement is granted.
model OrderItem {
  id              String        @id @default(cuid())
  orderId         String        @map("order_id")
  kind            OrderItemKind
  targetId        String        @map("target_id")
  title           String
  unitAmountMinor Int           @map("unit_amount_minor")
  quantity        Int           @default(1)
  createdAt       DateTime      @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("OrderItem")
}

/// Provider callbacks are durably claimed by provider/event id before any
/// entitlement write. The raw payload is retained only for reconciliation.
model PaymentAttempt {
  id                String          @id @default(cuid())
  orderId           String          @map("order_id")
  tenantId          String          @map("tenant_id")
  userId            String          @map("user_id")
  provider          PaymentProvider
  eventId           String          @map("event_id")
  providerReference String          @map("provider_reference")
  status            PaymentStatus   @default(PENDING)
  rawPayload        Json            @map("raw_payload")
  receivedAt        DateTime        @default(now()) @map("received_at")
  createdAt         DateTime        @default(now()) @map("created_at")

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, eventId])
  @@index([orderId, createdAt(sort: Desc)])
  @@index([tenantId, provider, createdAt(sort: Desc)])
  @@map("PaymentAttempt")
}

